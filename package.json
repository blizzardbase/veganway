{
  "name": "veganway-dxb",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false server/dev.ts",
    "start": "NODE_ENV=production tsx server/dev.ts",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "node --import tsx --test --test-concurrency=4 tests/api/*.test.ts",
    "test:dist": "node --import tsx --test tests/build/*.test.ts",
    "e2e": "playwright test",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build && npm run test:dist && npm run e2e",
    "migrate": "tsx server/migrate.ts",
    "admin": "tsx server/cli/admin.ts",
    "vercel-build": "npm run build && node --import tsx server/cli/vercel-migrate.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@fontsource-variable/manrope": "5.3.0",
    "@tanstack/react-query": "5.104.1",
    "@vercel/blob": "2.8.0",
    "express": "5.2.1",
    "lucide-react": "1.50.0",
    "motion": "13.5.1",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "zod": "4.6.5"
  },
  "overrides": {
    "playwright-core": "1.63.0",
    "qs": "6.16.0",
    "undici": "6.29.0",
    "rolldown": "1.2.12",
    "postcss": "8.5.28",
    "nanoid": "3.3.19",
    "acorn": "8.18.0",
    "@babel/helpers": "7.29.7",
    "@babel/traverse": "7.29.8",
    "baseline-browser-mapping": "2.11.27",
    "caniuse-lite": "1.0.30001814",
    "electron-to-chromium": "1.5.444",
    "node-releases": "2.0.57",
    "update-browserslist-db": "1.3.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2"
  }
}
